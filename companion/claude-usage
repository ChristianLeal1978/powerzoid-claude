#!/usr/bin/env python3
"""
claude-usage — CLI compañero para la extensión GNOME "Claude Usage Monitor"

Uso rápido:
  claude-usage set 75
  claude-usage set --used 150 --limit 200 --model "Claude Sonnet 4.5"
  claude-usage set --used 150 --limit 200 --reset-at "mañana 09:00"
  claude-usage status
  claude-usage reset

El comando escribe en:
  ~/.local/share/claude-usage/usage.json

La extensión GNOME lee ese archivo automáticamente.
"""

import argparse
import json
import os
import sys
from datetime import datetime
from pathlib import Path

# ── Rutas ─────────────────────────────────────────────────────────────────
USAGE_DIR   = Path.home() / ".local" / "share" / "claude-usage"
USAGE_FILE  = USAGE_DIR / "usage.json"
CONFIG_FILE = USAGE_DIR / "config.json"

# ── Colores ANSI ──────────────────────────────────────────────────────────
GREEN  = "\033[92m"
YELLOW = "\033[93m"
RED    = "\033[91m"
BLUE   = "\033[94m"
BOLD   = "\033[1m"
RESET  = "\033[0m"
DIM    = "\033[2m"

def color_for(pct):
    if pct >= 90: return RED
    if pct >= 60: return YELLOW
    return GREEN

def dot_for(pct):
    if pct >= 90: return "🔴"
    if pct >= 60: return "🟡"
    return "🟢"


# ── I/O de datos ──────────────────────────────────────────────────────────
def ensure_dir():
    USAGE_DIR.mkdir(parents=True, exist_ok=True)

def load_usage() -> dict:
    if not USAGE_FILE.exists():
        return {}
    try:
        return json.loads(USAGE_FILE.read_text(encoding="utf-8"))
    except Exception:
        return {}

def save_usage(data: dict):
    ensure_dir()
    data["updated_at"] = datetime.now().strftime("%H:%M  %d/%m/%Y")
    USAGE_FILE.write_text(
        json.dumps(data, indent=2, ensure_ascii=False),
        encoding="utf-8"
    )

def load_config() -> dict:
    if not CONFIG_FILE.exists():
        return {}
    try:
        return json.loads(CONFIG_FILE.read_text(encoding="utf-8"))
    except Exception:
        return {}

def save_config(cfg: dict):
    ensure_dir()
    CONFIG_FILE.write_text(
        json.dumps(cfg, indent=2, ensure_ascii=False),
        encoding="utf-8"
    )
    os.chmod(CONFIG_FILE, 0o600)  # solo el usuario puede leer la API key


# ── Subcomando: set ───────────────────────────────────────────────────────
def cmd_set(args):
    data = load_usage()

    # Modo rápido: claude-usage set 75
    if args.percentage is not None:
        pct = max(0.0, min(100.0, float(args.percentage)))
        data["percentage"] = round(pct, 1)

    # Mensajes usados y/o límite
    if args.used  is not None: data["used"]  = args.used
    if args.limit is not None: data["limit"] = args.limit

    # Calcular porcentaje desde used/limit si ambos están disponibles
    used  = data.get("used")
    limit = data.get("limit")
    if used is not None and limit and limit > 0:
        data["percentage"] = round(used / limit * 100, 1)

    if args.model    : data["model"]    = args.model
    if args.plan     : data["plan"]     = args.plan
    if args.reset_at : data["reset_at"] = args.reset_at

    save_usage(data)
    print(f"{GREEN}✓ Datos guardados{RESET}  →  {DIM}{USAGE_FILE}{RESET}")
    print()
    _print_status(data)


# ── Subcomando: status ────────────────────────────────────────────────────
def cmd_status(_args):
    data = load_usage()
    if not data:
        print(f"{YELLOW}Sin datos aún.{RESET}")
        print(f"Usa:  {BOLD}claude-usage set 75{RESET}")
        print(f"  o:  {BOLD}claude-usage set --used 150 --limit 200{RESET}")
        return
    _print_status(data)


def _print_status(data: dict):
    pct      = data.get("percentage", 0)
    used     = data.get("used",     "?")
    limit    = data.get("limit",    "?")
    model    = data.get("model",    "Claude")
    plan     = data.get("plan",     "")
    reset_at = data.get("reset_at", "N/D")
    upd_at   = data.get("updated_at", "N/D")

    col  = color_for(pct)
    dot  = dot_for(pct)
    line = "─" * 44

    plan_str = f"  ·  {plan}" if plan else ""
    print(f"\n{BOLD}{line}{RESET}")
    print(f"  {dot}  {BOLD}{model}{plan_str}{RESET}")
    print()

    # Barra de progreso en texto
    filled  = round(pct / 100 * 30)
    bar     = "▓" * filled + "░" * (30 - filled)
    print(f"  {col}{bar}{RESET}  {BOLD}{col}{pct}%{RESET}")
    print()
    print(f"  Mensajes  : {BOLD}{used}{RESET} / {limit}")
    print(f"  Reset     : {reset_at}")
    print(f"  Actualiz. : {DIM}{upd_at}{RESET}")
    print(f"{BOLD}{line}{RESET}\n")


# ── Subcomando: reset ─────────────────────────────────────────────────────
def cmd_reset(args):
    data = load_usage()
    data["percentage"] = 0
    data["used"]       = 0
    if args.reset_at:
        data["reset_at"] = args.reset_at
    save_usage(data)
    print(f"{GREEN}✓ Uso reiniciado a 0%.{RESET}")


# ── Subcomando: config ────────────────────────────────────────────────────
def cmd_config(args):
    cfg = load_config()
    changed = False

    if args.api_key:
        cfg["api_key"] = args.api_key
        changed = True

    if args.model:
        cfg["default_model"] = args.model
        changed = True

    if args.plan:
        cfg["default_plan"] = args.plan
        changed = True

    if changed:
        save_config(cfg)
        print(f"{GREEN}✓ Configuración guardada en {CONFIG_FILE}{RESET}")
    else:
        print(f"{BOLD}Configuración actual:{RESET}")
        if cfg:
            for k, v in cfg.items():
                val = ("*" * 8 + v[-4:]) if k == "api_key" and len(v) > 8 else v
                print(f"  {k}: {val}")
        else:
            print(f"  {DIM}(vacía){RESET}")


# ── Subcomando: fetch (Anthropic API) ─────────────────────────────────────
def cmd_fetch(_args):
    """
    Intenta obtener el uso desde la API de Anthropic.
    Requiere ANTHROPIC_API_KEY o que hayas ejecutado:
        claude-usage config --api-key sk-ant-...

    NOTA: La API de Anthropic expone uso de tokens/mensajes de la API,
    no los límites de sesión de Claude.ai. Para uso de claude.ai
    actualiza manualmente con 'claude-usage set'.
    """
    api_key = os.environ.get("ANTHROPIC_API_KEY") or load_config().get("api_key")

    if not api_key:
        print(f"{RED}Error:{RESET} No hay API key configurada.")
        print(f"  Opción 1: export ANTHROPIC_API_KEY=sk-ant-...")
        print(f"  Opción 2: claude-usage config --api-key sk-ant-...")
        sys.exit(1)

    import urllib.request
    import urllib.error

    headers = {
        "x-api-key":           api_key,
        "anthropic-version":   "2023-06-01",
        "content-type":        "application/json",
    }

    # Endpoints candidatos (Anthropic no documenta uno definitivo para "cuota")
    endpoints = [
        "https://api.anthropic.com/v1/usage",
    ]

    for url in endpoints:
        try:
            req = urllib.request.Request(url, headers=headers)
            with urllib.request.urlopen(req, timeout=10) as resp:
                payload = json.loads(resp.read())
            print(f"{GREEN}Respuesta de {url}:{RESET}")
            print(json.dumps(payload, indent=2, ensure_ascii=False))
            return
        except urllib.error.HTTPError as e:
            print(f"{YELLOW}HTTP {e.code}{RESET} en {url}")
        except Exception as e:
            print(f"{RED}Error:{RESET} {e}")

    print()
    print(f"{YELLOW}⚠ La API de Anthropic no expone límites de sesión de Claude.ai.{RESET}")
    print(f"Actualiza tu uso manualmente:")
    print(f"  {BOLD}claude-usage set --used 150 --limit 200{RESET}")


# ── Parser principal ──────────────────────────────────────────────────────
def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="claude-usage",
        description="Gestiona el porcentaje de uso de Claude para la extensión GNOME.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Ejemplos:
  claude-usage set 75
  claude-usage set --used 150 --limit 200 --model "Claude Sonnet 4.5"
  claude-usage set --used 190 --limit 200 --reset-at "mañana 09:00"
  claude-usage status
  claude-usage reset --reset-at "09:00 del 09/06/2026"
  claude-usage config --api-key sk-ant-...
  claude-usage fetch
        """,
    )
    sub = p.add_subparsers(dest="command", metavar="<comando>")

    # set
    ps = sub.add_parser("set", help="Establece el uso actual")
    ps.add_argument("percentage", type=float, nargs="?",
                    help="Porcentaje directo (0-100), e.g.: claude-usage set 75")
    ps.add_argument("--used",     type=int,   metavar="N",   help="Mensajes usados")
    ps.add_argument("--limit",    type=int,   metavar="N",   help="Límite total de mensajes")
    ps.add_argument("--model",    type=str,   metavar="STR", help='Nombre del modelo, e.g. "Claude Sonnet 4.5"')
    ps.add_argument("--plan",     type=str,   metavar="STR", help='Plan, e.g. "Pro"')
    ps.add_argument("--reset-at", dest="reset_at", type=str, metavar="STR",
                    help='Cuándo se resetea, e.g. "mañana 09:00"')

    # status
    sub.add_parser("status", help="Muestra el estado actual")

    # reset
    pr = sub.add_parser("reset", help="Reinicia el contador a 0%%")
    pr.add_argument("--reset-at", dest="reset_at", type=str, metavar="STR",
                    help="Próxima fecha de reset")

    # config
    pc = sub.add_parser("config", help="Configura opciones persistentes")
    pc.add_argument("--api-key", dest="api_key", type=str, help="API key de Anthropic")
    pc.add_argument("--model",   type=str, help="Modelo predeterminado")
    pc.add_argument("--plan",    type=str, help="Plan predeterminado (Free/Pro/Team)")

    # fetch
    sub.add_parser("fetch", help="Intenta obtener uso desde la API de Anthropic")

    return p


def main():
    parser = build_parser()
    args   = parser.parse_args()

    dispatch = {
        "set":    cmd_set,
        "status": cmd_status,
        "reset":  cmd_reset,
        "config": cmd_config,
        "fetch":  cmd_fetch,
    }

    fn = dispatch.get(args.command)
    if fn:
        fn(args)
    else:
        parser.print_help()


if __name__ == "__main__":
    main()
