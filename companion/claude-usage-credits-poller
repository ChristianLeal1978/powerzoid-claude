#!/usr/bin/env python3
"""
claude-usage-credits-poller — Obtiene automáticamente dos saldos que no tienen
API pública, usando un navegador Chromium controlado por Playwright con sesión
persistente:

  1. "Organization credits" del Dashboard del Console (platform.claude.com) →
     api_credits_usd
  2. "Current balance" de Usage credits en claude.ai (settings/usage) →
     usage_credits_balance_usd

Primer uso (una sola vez):
    claude-usage-credits-poller --login
    → Se abre un navegador visible. Inicia sesión en el Dashboard del Console
      y espera a ver la tarjeta "Organization credits"; presiona Enter en la
      terminal. Luego se navega a claude.ai — inicia sesión ahí también si se
      pide, espera a ver "Current balance" bajo "Usage credits", y presiona
      Enter de nuevo.

    Si ya tienes uno de los dos guardado (p.ej. el Dashboard del Console) y
    solo falta el otro, usa:
      claude-usage-credits-poller --login-usage-credits   # solo claude.ai
      claude-usage-credits-poller --login-dashboard        # solo el Console

Uso normal (automático, sin ventana visible):
    claude-usage-credits-poller             # una consulta
    claude-usage-credits-poller --watch      # bucle cada --interval segundos

La sesión (cookies) queda guardada en un perfil de Chromium dedicado en:
    ~/.local/share/claude-usage/browser-profile
Esto no toca tu navegador normal ni tus otras cuentas.
"""

import argparse
import json
import re
import sys
import time
from datetime import datetime
from pathlib import Path

DASHBOARD_URL     = "https://platform.claude.com/dashboard"
USAGE_CREDITS_URL = "https://claude.ai/projects#settings/usage"
USAGE_DIR         = Path.home() / ".local" / "share" / "claude-usage"
USAGE_FILE        = USAGE_DIR / "usage.json"
PROFILE_DIR       = USAGE_DIR / "browser-profile"

G = "\033[92m"; Y = "\033[93m"; R = "\033[91m"
B = "\033[2m";  NC = "\033[0m"; BOLD = "\033[1m"

def ts():  return datetime.now().strftime("%H:%M:%S")
def log(msg, col=""): print(f"{B}[{ts()}]{NC} {col}{msg}{NC}")


# Busca "$XX.XX" apareciendo después de la etiqueta "Organization credits"
# en el texto visible de la página (independiente de la estructura exacta del DOM).
CREDIT_RE = re.compile(r"Organization credits.{0,200}?\$([\d,]+\.\d{2})",
                        re.IGNORECASE | re.DOTALL)

# En claude.ai el monto aparece ANTES de la etiqueta: "$7.57 \n Current balance".
USAGE_BALANCE_RE = re.compile(r"\$([\d,]+\.\d{2}).{0,50}?Current balance",
                               re.IGNORECASE | re.DOTALL)


def _get_playwright():
    try:
        from playwright.sync_api import sync_playwright
    except ImportError:
        log("El paquete 'playwright' no está instalado.", R)
        log("Instálalo con:", Y)
        log("  pip install --user playwright", Y)
        log("  python3 -m playwright install chromium", Y)
        sys.exit(1)
    return sync_playwright().start()


def _open_context(headless: bool):
    PROFILE_DIR.mkdir(parents=True, exist_ok=True)
    pw = _get_playwright()
    try:
        context = pw.chromium.launch_persistent_context(
            str(PROFILE_DIR),
            headless=headless,
            viewport={"width": 1280, "height": 900},
        )
    except Exception as e:
        pw.stop()
        log(f"No se pudo iniciar Chromium: {e}", R)
        log("¿Falta el navegador? Instálalo con: python3 -m playwright install chromium", Y)
        sys.exit(1)
    return pw, context


def extract_credits(page) -> float | None:
    try:
        page.wait_for_load_state("networkidle", timeout=15000)
    except Exception:
        pass
    try:
        page.wait_for_selector("text=Organization credits", timeout=10000)
    except Exception:
        pass
    text = page.inner_text("body")
    m = CREDIT_RE.search(text)
    if not m:
        return None
    return float(m.group(1).replace(",", ""))


def extract_usage_credits_balance(page) -> float | None:
    try:
        page.wait_for_load_state("networkidle", timeout=15000)
    except Exception:
        pass
    try:
        page.wait_for_selector("text=Current balance", timeout=10000)
    except Exception:
        pass
    text = page.inner_text("body")
    m = USAGE_BALANCE_RE.search(text)
    if not m:
        return None
    return float(m.group(1).replace(",", ""))


def save_credits(amount: float | None = None, balance: float | None = None):
    USAGE_DIR.mkdir(parents=True, exist_ok=True)
    data = {}
    if USAGE_FILE.exists():
        try:
            data = json.loads(USAGE_FILE.read_text())
        except Exception:
            pass
    now = datetime.now().strftime("%H:%M  %d/%m/%Y")
    if amount is not None:
        data["api_credits_usd"]        = round(amount, 2)
        data["api_credits_updated_at"] = now
        data["api_credits_source"]     = "console-poller"
    if balance is not None:
        data["usage_credits_balance_usd"]         = round(balance, 2)
        data["usage_credits_balance_updated_at"]  = now
        data["usage_credits_balance_source"]      = "claude-ai-poller"
    USAGE_FILE.write_text(json.dumps(data, indent=2, ensure_ascii=False))


def _login_dashboard(page) -> float | None:
    page.goto(DASHBOARD_URL)
    log("Inicia sesión en la ventana del navegador que se abrió.", Y)
    log("Cuando veas el Dashboard con la tarjeta 'Organization credits',", Y)
    log("vuelve aquí y presiona Enter.", Y)
    try:
        input()
    except (EOFError, KeyboardInterrupt):
        pass
    credits = extract_credits(page)
    if credits is not None:
        log(f"✓ Organization credits: ${credits:.2f}", G)
    else:
        log("No se pudo detectar 'Organization credits' todavía.", R)
    return credits


def _login_usage_credits(page) -> float | None:
    page.goto(USAGE_CREDITS_URL)
    log("Inicia sesión en claude.ai en la ventana que se abrió (si te lo pide).", Y)
    log("Cuando veas 'Current balance' bajo 'Usage credits', vuelve aquí y presiona Enter.", Y)
    try:
        input()
    except (EOFError, KeyboardInterrupt):
        pass
    balance = extract_usage_credits_balance(page)
    if balance is not None:
        log(f"✓ Usage credits — Current balance: ${balance:.2f}", G)
    else:
        log("No se pudo detectar 'Current balance' todavía.", R)
        log("Verifica que la sección 'Usage credits' esté activada y visible.", Y)
    return balance


def cmd_login(only: str | None = None):
    pw, context = _open_context(headless=False)
    page = context.pages[0] if context.pages else context.new_page()

    credits = None
    balance = None

    if only != "usage-credits":
        credits = _login_dashboard(page)
    if only != "dashboard":
        balance = _login_usage_credits(page)

    if credits is not None or balance is not None:
        save_credits(credits, balance)

    context.close()
    pw.stop()

    if only == "usage-credits":
        ok = balance is not None
    elif only == "dashboard":
        ok = credits is not None
    else:
        ok = credits is not None and balance is not None
    sys.exit(0 if ok else 1)


def run_once(headless: bool) -> bool:
    pw, context = _open_context(headless=headless)
    page = context.pages[0] if context.pages else context.new_page()

    credits = None
    balance = None
    try:
        page.goto(DASHBOARD_URL, timeout=30000)
        credits = extract_credits(page)
    except Exception as e:
        log(f"Error al cargar el Dashboard: {e}", R)

    try:
        page.goto(USAGE_CREDITS_URL, timeout=30000)
        balance = extract_usage_credits_balance(page)
    except Exception as e:
        log(f"Error al cargar claude.ai/settings/usage: {e}", R)

    context.close()
    pw.stop()

    if credits is None and balance is None:
        log("No se pudo leer ningún saldo.", R)
        log("Si la sesión expiró, vuelve a correr: claude-usage-credits-poller --login", Y)
        return False

    save_credits(credits, balance)
    if credits is not None:
        log(f"✓ Organization credits: ${credits:.2f}", G)
    else:
        log("⚠ No se pudo leer Organization credits.", Y)
    if balance is not None:
        log(f"✓ Usage credits (Current balance): ${balance:.2f}", G)
    else:
        log("⚠ No se pudo leer Current balance de Usage credits.", Y)
    return True


def main():
    p = argparse.ArgumentParser(prog="claude-usage-credits-poller")
    p.add_argument("--login",    action="store_true",
                    help="Abre el navegador visible para iniciar sesión en el Dashboard (Console) "
                         "y luego en claude.ai (Usage credits)")
    p.add_argument("--login-usage-credits", action="store_true",
                    help="Igual que --login pero solo para claude.ai / Usage credits "
                         "(omite el Dashboard del Console)")
    p.add_argument("--login-dashboard", action="store_true",
                    help="Igual que --login pero solo para el Dashboard del Console "
                         "(omite claude.ai / Usage credits)")
    p.add_argument("--watch",    action="store_true", help="Bucle cada --interval segundos")
    p.add_argument("--interval", type=int, default=900,
                    help="Segundos entre consultas en modo --watch (default: 900 = 15 min)")
    p.add_argument("--debug",    action="store_true",
                    help="Corre con navegador visible (útil para depurar el scraping)")
    args = p.parse_args()

    if args.login_usage_credits:
        cmd_login(only="usage-credits")
        return
    if args.login_dashboard:
        cmd_login(only="dashboard")
        return
    if args.login:
        cmd_login()
        return

    if args.watch:
        log(f"Modo watch — cada {args.interval}s  (Ctrl+C para detener)")
        while True:
            run_once(headless=not args.debug)
            time.sleep(args.interval)
    else:
        ok = run_once(headless=not args.debug)
        sys.exit(0 if ok else 1)


if __name__ == "__main__":
    main()
