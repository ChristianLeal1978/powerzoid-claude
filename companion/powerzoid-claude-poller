# ══════════════════════════════════════════════════════════════════════════════
#  DETECCIÓN DE NAVEGADOR ACTIVO
# ══════════════════════════════════════════════════════════════════════════════

def is_running(process_names: list) -> bool:
    """Comprueba si alguno de los procesos está en ejecución."""
    for name in process_names:
        try:
            r = subprocess.run(["pgrep", "-f", name],
                               capture_output=True, text=True)
            if r.stdout.strip():
                return True
        except Exception:
            pass
    return False


def find_cookie_dbs(path_patterns: list) -> list:
    """Expande los patrones glob y devuelve los archivos encontrados."""
    dbs = []
    for pattern in path_patterns:
        dbs.extend(glob.glob(os.path.expanduser(pattern)))
    return dbs


# ══════════════════════════════════════════════════════════════════════════════
#  LECTURA DE COOKIES — FIREFOX
# ══════════════════════════════════════════════════════════════════════════════

def get_firefox_cookies(db_paths: list, domain: str) -> tuple[dict, float]:
    """
    Lee cookies de Firefox (SQLite sin cifrar).
    Devuelve (cookies_dict, last_access_timestamp).
    """
    cookies     = {}
    last_access = 0.0

    for db_path in db_paths:
        tmp = None
        try:
            fd, tmp = tempfile.mkstemp(suffix=".sqlite")
            os.close(fd)
            shutil.copy2(db_path, tmp)

            conn = sqlite3.connect(tmp)
            cur  = conn.cursor()
            cur.execute("""
                SELECT name, value, lastAccessed
                FROM   moz_cookies
                WHERE  host LIKE ?
                ORDER  BY lastAccessed DESC
            """, (f"%{domain}%",))

            for name, value, accessed in cur.fetchall():
                if name not in cookies:
                    cookies[name] = value
                if accessed > last_access:
                    last_access = accessed   # microsegundos desde epoch Unix
            conn.close()

        except Exception as e:
            log(f"Firefox ({db_path}): {e}", Y)
        finally:
            if tmp and os.path.exists(tmp):
                os.unlink(tmp)

    # Convertir microsegundos a segundos
    last_access_sec = last_access / 1_000_000 if last_access else 0.0
    return cookies, last_access_sec


# ══════════════════════════════════════════════════════════════════════════════
#  LECTURA DE COOKIES — CHROME / VIVALDI / CHROMIUM
# ══════════════════════════════════════════════════════════════════════════════

def get_chrome_key(keyring_label) -> bytes:
    """
    Obtiene la clave de cifrado desde GNOME Keyring.
    Acepta una etiqueta única o una lista de etiquetas candidatas (algunas
    apps empaquetadas como Flatpak registran la clave con otro nombre).
    Si no está disponible, usa la clave por defecto de Chromium en Linux.
    """
    labels = [keyring_label] if isinstance(keyring_label, str) else list(keyring_label)
    try:
        import secretstorage
        bus        = secretstorage.dbus_init()
        collection = secretstorage.get_default_collection(bus)
        if collection.is_locked():
            collection.unlock()
        for item in collection.get_all_items():
            if item.get_label() in labels:
                return item.get_secret()
    except Exception:
        pass
    # Clave por defecto cuando no hay keyring configurado
    return b"peanuts"


def decrypt_chrome_cookie(encrypted: bytes, key: bytes) -> str:
    """
    Descifra un valor de cookie de Chromium (formato v10/v11, AES-128-CBC).
    Requiere el paquete 'cryptography' (python3-cryptography en Fedora).
    """
    if not encrypted:
        return ""

    # Sin cifrar (cookies antiguas o de sesión sin cifrar)
    if not (encrypted.startswith(b"v10") or encrypted.startswith(b"v11")):
        try:
            return encrypted.decode("utf-8")
        except Exception:
            return ""

    try:
        from cryptography.hazmat.primitives.kdf.pbkdf2 import PBKDF2HMAC
        from cryptography.hazmat.primitives             import hashes
        from cryptography.hazmat.primitives.ciphers    import Cipher, algorithms, modes
        from cryptography.hazmat.backends              import default_backend

        payload = encrypted[3:]   # quitar prefijo v10/v11

        # Derivar clave AES-128 con PBKDF2 (1 iteración, salt fijo de Chromium)
        kdf = PBKDF2HMAC(
            algorithm  = hashes.SHA1(),
            length     = 16,
            salt       = b"saltysalt",
            iterations = 1,
            backend    = default_backend(),
        )
        aes_key = kdf.derive(key)
        iv      = b" " * 16   # IV fijo de Chromium

        cipher    = Cipher(algorithms.AES(aes_key), modes.CBC(iv),
                           backend=default_backend())
        decryptor = cipher.decryptor()
        decrypted = decryptor.update(payload) + decryptor.finalize()

        # Quitar padding PKCS5
        pad = decrypted[-1]
        return decrypted[:-pad].decode("utf-8")

    except ImportError:
        log("'cryptography' no instalado — omitiendo cookies cifradas de Chrome.", Y)
        log("  Para activarlo: sudo dnf install python3-cryptography", Y)
        return ""
    except Exception as e:
        log(f"Error descifrando cookie: {e}", Y)
        return ""


# Chrome almacena tiempos como microsegundos desde 1601-01-01 (época Windows)
_CHROME_EPOCH_OFFSET = 11_644_473_600  # segundos entre 1601 y 1970

def chrome_ts_to_unix(chrome_ts: int) -> float:
    """Convierte timestamp de Chrome a Unix timestamp (segundos)."""
    return max(0.0, chrome_ts / 1_000_000 - _CHROME_EPOCH_OFFSET)


def get_chrome_cookies(db_paths: list, keyring_label: str,
                       domain: str) -> tuple[dict, float]:
    """
    Lee y descifra cookies de Chrome/Vivaldi/Chromium.
    Devuelve (cookies_dict, last_access_unix_timestamp).
    """
    aes_key     = get_chrome_key(keyring_label)
    cookies     = {}
    last_access = 0.0

    for db_path in db_paths:
        if not os.path.exists(os.path.expanduser(db_path)):
            continue
        tmp = None
        try:
            fd, tmp = tempfile.mkstemp(suffix=".sqlite")
            os.close(fd)
            shutil.copy2(os.path.expanduser(db_path), tmp)

            conn = sqlite3.connect(tmp)
            cur  = conn.cursor()
            cur.execute("""
                SELECT name, encrypted_value, last_access_utc
                FROM   cookies
                WHERE  host_key LIKE ?
                ORDER  BY last_access_utc DESC
            """, (f"%{domain}%",))

            for name, enc_value, access_utc in cur.fetchall():
                value = decrypt_chrome_cookie(enc_value, aes_key)
                if value and name not in cookies:
                    cookies[name] = value
                ts_unix = chrome_ts_to_unix(access_utc)
                if ts_unix > last_access:
                    last_access = ts_unix
            conn.close()

        except Exception as e:
            log(f"Chrome/Vivaldi ({db_path}): {e}", Y)
        finally:
            if tmp and os.path.exists(tmp):
                os.unlink(tmp)

    return cookies, last_access


# ══════════════════════════════════════════════════════════════════════════════
#  SELECCIÓN DEL MEJOR NAVEGADOR
# ══════════════════════════════════════════════════════════════════════════════

def find_best_cookies(domain: str = DOMAIN) -> tuple[dict, str]:
    """
    Prueba todos los navegadores y devuelve las cookies del que tenga
    la sesión de claude.ai más reciente.
    Prioriza los navegadores que estén en ejecución.
    """
    candidates = []  # [(last_access, cookies, browser_name)]

    for browser in BROWSERS:
        dbs = find_cookie_dbs(browser["paths"])
        if not dbs:
            continue

        running = is_running(browser["process"])

        if browser["type"] == "firefox":
            cookies, last_access = get_firefox_cookies(dbs, domain)
        else:
            keyring = browser.get("keyring", "Chrome Safe Storage")
            cookies, last_access = get_chrome_cookies(dbs, keyring, domain)

        if not cookies:
            continue

        # Penalizar navegadores que no están en ejecución (restar 10h)
        effective_access = last_access if running else last_access - 36_000
        status = "▶ corriendo" if running else "■ cerrado"
        log(f"  {browser['name']:10s} {status}  "
            f"última sesión: {fmt_ago(last_access)}", B)

        candidates.append((effective_access, cookies, browser["name"]))

    if not candidates:
        return {}, ""

    # Elegir el que tenga acceso más reciente
    candidates.sort(key=lambda x: x[0], reverse=True)
    _, best_cookies, best_name = candidates[0]
    return best_cookies, best_name


def fmt_ago(ts: float) -> str:
    """Formatea cuánto tiempo hace desde un timestamp Unix."""
    if not ts:
        return "desconocido"
    diff = time.time() - ts
    if diff < 60:        return "hace <1 min"
    if diff < 3600:      return f"hace {int(diff/60)} min"
    if diff < 86400:     return f"hace {int(diff/3600)} h"
    return f"hace {int(diff/86400)} días"


