#!/usr/bin/env python3
"""
powerzoid-claude-poller — Consulta claude.ai leyendo cookies del navegador activo.

Detecta automáticamente qué navegador tiene Claude abierto
(Firefox, Chrome, Vivaldi) y usa sus cookies.

Uso:
    powerzoid-claude-poller           # consulta única
    powerzoid-claude-poller --watch   # bucle cada 5 minutos
    powerzoid-claude-poller --debug   # vuelca respuestas de la API
"""

import glob, json, os, shutil, sqlite3, subprocess
import sys, tempfile, time, urllib.request, urllib.error
from datetime import datetime, timezone
from pathlib import Path

# ── Rutas y constantes ────────────────────────────────────────────────────────
USAGE_DIR  = Path.home() / ".local" / "share" / "powerzoid-claude"
USAGE_FILE = USAGE_DIR / "usage.json"
DOMAIN     = "claude.ai"

G = "\033[92m"; Y = "\033[93m"; R = "\033[91m"
B = "\033[2m";  NC = "\033[0m"; BOLD = "\033[1m"

def ts():  return datetime.now().strftime("%H:%M:%S")
def log(msg, col=""): print(f"{B}[{ts()}]{NC} {col}{msg}{NC}")


