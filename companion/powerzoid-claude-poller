#  API DE CLAUDE.AI
# ══════════════════════════════════════════════════════════════════════════════

def cookies_to_header(cookies: dict) -> str:
    return "; ".join(f"{k}={v}" for k, v in cookies.items())


def api_get(path: str, cookies: dict):
    url     = f"https://claude.ai{path}"
    headers = {
        "Cookie"          : cookies_to_header(cookies),
        "Accept"          : "application/json",
        "User-Agent"      : "Mozilla/5.0 (X11; Linux x86_64; rv:125.0) Gecko/20100101 Firefox/125.0",
        "Referer"         : "https://claude.ai/",
        "Accept-Language" : "es-CL,es;q=0.9,en;q=0.8",
    }
    try:
        req = urllib.request.Request(url, headers=headers)
        with urllib.request.urlopen(req, timeout=10) as resp:
            return json.loads(resp.read())
    except urllib.error.HTTPError as e:
        log(f"HTTP {e.code} en {path}", Y)
        return None
    except Exception as e:
        log(f"Error en {path}: {e}", R)
        return None


def get_org_uuid(cookies: dict) -> str | None:
    # Leer caché primero (evita una llamada API en cada ciclo de 60s)
    if USAGE_FILE.exists():
        try:
            cached = json.loads(USAGE_FILE.read_text()).get("_org_uuid")
            if cached:
                return cached
        except Exception:
            pass
    # Primera vez: consultar la API
    orgs = api_get("/api/organizations", cookies)
    if isinstance(orgs, list) and orgs:
        return orgs[0].get("uuid") or str(orgs[0].get("id"))
    return None


def format_reset_time(iso_ts: str) -> str:
    try:
        dt    = datetime.fromisoformat(iso_ts)
        local = dt.astimezone()
        now   = datetime.now(timezone.utc).astimezone()
        diff_h = (local - now).total_seconds() / 3600
        if diff_h < 1:
            mins = int((local - now).total_seconds() / 60)
            return f"en {mins} min ({local.strftime('%H:%M')})"
        elif diff_h < 24:
            return f"hoy {local.strftime('%H:%M')}"
        else:
            return local.strftime("%H:%M del %d/%m")
    except Exception:
        return iso_ts


def parse_usage_response(data: dict) -> dict | None:
    WINDOWS = [
        ("five_hour", "5h"), ("seven_day_sonnet", "7d Sonnet"),
        ("seven_day_opus", "7d Opus"), ("seven_day", "7d"),
    ]
    windows = {}
    for key, label in WINDOWS:
        w = data.get(key)
        if w and isinstance(w, dict) and w.get("utilization") is not None:
            windows[key] = {
                "label"      : label,
                "utilization": float(w["utilization"]),
                "resets_at"  : w.get("resets_at"),
            }
    if not windows:
        return None

    primary_key = "five_hour" if "five_hour" in windows else max(
        windows, key=lambda k: windows[k]["utilization"]
    )
    primary     = windows[primary_key]
    pct         = round(primary["utilization"], 1)
    reset_str   = format_reset_time(primary["resets_at"]) if primary["resets_at"] else "N/D"

    summary = "  |  ".join(
        f"{w['label']}: {w['utilization']:.0f}%" for w in windows.values()
    )
    log(f"  Ventanas: {summary}", B)

    return {
        "percentage"  : pct,
        "model"       : f"Claude Max ({primary['label']})",
        "reset_at"    : reset_str,
        "reset_at_iso": primary["resets_at"] or "",   # ISO para cálculo en la extensión
        "window"      : primary_key,
    }


def fetch_usage(cookies: dict) -> dict | None:
    org_uuid = get_org_uuid(cookies)
    if not org_uuid:
        log("No se pudo obtener el UUID de la organización.", R)
        return None
    log(f"Consultando uso para org {org_uuid[:8]}…", B)
    data = api_get(f"/api/organizations/{org_uuid}/usage", cookies)
    result = parse_usage_response(data) if data else None
    if result:
        result["_org_uuid"] = org_uuid   # para caché
    return result


# Mismo endpoint que consulta la página Configuración → Uso → "Usage credits"
# de claude.ai. A diferencia de powerzoid-claude-credits-poller (que abre un
# navegador Chromium automatizado y choca con Cloudflare), esto es una simple
# petición GET autenticada por cookie, igual que /usage arriba — por eso sí
# funciona sin sesión visible ni navegador abierto.
def fetch_credits_balance(cookies: dict, org_uuid: str) -> float | None:
    data = api_get(f"/api/organizations/{org_uuid}/prepaid/credits", cookies)
    if not isinstance(data, dict):
        return None
    amount = data.get("amount")
    if amount is None:
        return None
    try:
        return round(amount / 100, 2)
    except (TypeError, ValueError):
        return None


def save_usage(usage: dict):
    USAGE_DIR.mkdir(parents=True, exist_ok=True)
    existing = {}
    if USAGE_FILE.exists():
        try:
            existing = json.loads(USAGE_FILE.read_text())
        except Exception:
            pass
    merged = {**existing, **usage}
    merged["updated_at"] = datetime.now().strftime("%H:%M  %d/%m/%Y")
    merged["source"]     = "poller"
    # Cachear UUID si está en el payload (lo añade fetch_usage)
    if "_org_uuid" in usage:
        merged["_org_uuid"] = usage["_org_uuid"]
    USAGE_FILE.write_text(json.dumps(merged, indent=2, ensure_ascii=False))
    log(f"Guardado: {merged.get('percentage','?')}%  "
        f"({merged.get('used','?')}/{merged.get('limit','?')})", G)


def save_credits_balance(balance_usd: float):
    USAGE_DIR.mkdir(parents=True, exist_ok=True)
    existing = {}
    if USAGE_FILE.exists():
        try:
            existing = json.loads(USAGE_FILE.read_text())
        except Exception:
            pass
    existing["usage_credits_balance_usd"]        = balance_usd
    existing["usage_credits_balance_updated_at"] = datetime.now().strftime("%H:%M  %d/%m/%Y")
    existing["usage_credits_balance_source"]     = "poller"
    USAGE_FILE.write_text(json.dumps(existing, indent=2, ensure_ascii=False))
    log(f"Guardado: usage credits ${balance_usd:.2f}", G)


# ══════════════════════════════════════════════════════════════════════════════
#  ENTRYPOINTS
# ══════════════════════════════════════════════════════════════════════════════

def run_once(verbose=True) -> bool:
    if verbose:
        log("Buscando navegador con sesión de claude.ai…")

    cookies, browser_name = find_best_cookies()

    if not cookies:
        log("No se encontró ninguna sesión de claude.ai en ningún navegador.", R)
        return False

    log(f"Usando cookies de {BOLD}{browser_name}{NC}", G)

    ok = False

    usage = fetch_usage(cookies)
    if usage:
        save_usage(usage)
        ok = True
    else:
        log("No se encontraron datos de uso.", Y)

    org_uuid = get_org_uuid(cookies)
    if org_uuid:
        balance = fetch_credits_balance(cookies, org_uuid)
        if balance is not None:
            save_credits_balance(balance)
            ok = True
        else:
            log("No se encontró el saldo de usage credits.", Y)

    return ok


def debug_dump():
    log("Buscando navegador con sesión de claude.ai…")
    cookies, browser_name = find_best_cookies()
    if not cookies:
        log("No hay cookies.", R)
        return

    log(f"Usando {browser_name}")
    print(f"\n{BOLD}=== Endpoints de claude.ai ==={NC}\n")

    org_uuid = get_org_uuid(cookies)
    endpoints = ["/api/account", "/api/bootstrap", "/api/organizations"]
    if org_uuid:
        endpoints += [
            f"/api/organizations/{org_uuid}/usage",
            f"/api/organizations/{org_uuid}/rate_limits",
            f"/api/organizations/{org_uuid}/prepaid/credits",
        ]

    for ep in endpoints:
        print(f"{BOLD}── {ep} ──{NC}")
        data = api_get(ep, cookies)
        print(json.dumps(data, indent=2, ensure_ascii=False)[:1500] if data else "  (sin respuesta)")
        print()


def main():
    import argparse
    p = argparse.ArgumentParser(prog="powerzoid-claude-poller")
    p.add_argument("--watch",    action="store_true", help="Bucle cada N segundos")
    p.add_argument("--interval", type=int, default=300)
    p.add_argument("--debug",    action="store_true", help="Vuelca respuestas API")
    args = p.parse_args()

    if args.debug:
        debug_dump()
    elif args.watch:
        log(f"Modo watch — cada {args.interval}s  (Ctrl+C para detener)")
        while True:
            run_once(verbose=False)
            time.sleep(args.interval)
    else:
        sys.exit(0 if run_once() else 1)


if __name__ == "__main__":
    main()
